# ============================================================================
# SignalDACH Backend -- Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# All variables are prefixed with SIGNALDACH_ (Pydantic env_prefix).
# ============================================================================

# ---------- Environment ----------
# Set to "production" for strict validation, "development" for relaxed mode
SIGNALDACH_ENV=development

# ---------- Database ----------
# SQLite (default for development):
# SIGNALDACH_DATABASE_URL=sqlite:///signaldach.db
# PostgreSQL (required for production):
# SIGNALDACH_DATABASE_URL=postgresql://user:password@localhost:5432/signaldach
# TimescaleDB (recommended for production):
# SIGNALDACH_DATABASE_URL=postgresql://user:password@localhost:5432/signaldach

# ---------- Redis ----------
SIGNALDACH_REDIS_URL=redis://localhost:6379

# ---------- Authentication ----------
# CRITICAL: Generate a secure secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SIGNALDACH_JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
SIGNALDACH_ACCESS_TOKEN_EXPIRE_MINUTES=30
SIGNALDACH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
SIGNALDACH_AUTH_ENABLED=true

# ---------- AI Providers ----------
# At least one is required for signal analysis
SIGNALDACH_OPENAI_API_KEY=
SIGNALDACH_ANTHROPIC_API_KEY=
SIGNALDACH_LLM_PROVIDER=auto

# ---------- CORS ----------
# Comma-separated origins
SIGNALDACH_CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ---------- Monitoring ----------
SIGNALDACH_SENTRY_DSN=
SIGNALDACH_LOG_LEVEL=INFO
SIGNALDACH_LOG_FORMAT=text

# ---------- Rate Limiting ----------
SIGNALDACH_RATE_LIMIT_PER_MINUTE=100
SIGNALDACH_RATE_LIMIT_AUTH_PER_MINUTE=20

# ---------- Email (Resend) ----------
SIGNALDACH_RESEND_API_KEY=

# ---------- Social Scraping ----------
SIGNALDACH_TWITTER_BEARER_TOKEN=
SIGNALDACH_REDDIT_CLIENT_ID=
SIGNALDACH_REDDIT_CLIENT_SECRET=
SIGNALDACH_REDDIT_USER_AGENT=SignalDACH/0.1

# ---------- Scraping ----------
SIGNALDACH_SCRAPE_ON_STARTUP=false

# ---------- Slow Query Logging ----------
SIGNALDACH_SLOW_QUERY_MS=100

# ---------- Feature Flags ----------
# Override any flag: SIGNALDACH_FF_<FLAG_NAME>=true/false
# SIGNALDACH_FF_TRADING_LIVE=false
# SIGNALDACH_FF_PAPER_TRADING=true
# SIGNALDACH_FF_ML_FINBERT=true
