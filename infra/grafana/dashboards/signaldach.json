{
  "id": null,
  "uid": "signaldach-overview",
  "title": "SignalDACH Overview",
  "description": "AI-powered crypto market intelligence for DACH region",
  "tags": ["signaldach", "crypto", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "style": "dark",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "System Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "description": "Total HTTP requests since startup",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "signaldach_http_requests_total",
          "legendFormat": "Requests",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "description": "Percentage of 5xx errors",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "(signaldach_http_errors_total / clamp_min(signaldach_http_requests_total, 1)) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active WebSocket Connections",
      "description": "Currently connected WebSocket clients",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "signaldach_ws_connections_active",
          "legendFormat": "Active WS",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Signals Generated",
      "description": "Total AI signals generated",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "signaldach_signals_generated_total",
          "legendFormat": "Signals",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "API Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 2,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request Latency (ms)",
      "description": "Average HTTP request latency over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 20,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "ms",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 2000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "signaldach_http_latency_avg_ms",
          "legendFormat": "Avg Latency",
          "refId": "A"
        },
        {
          "expr": "signaldach_endpoint_latency_p50_ms",
          "legendFormat": "p50 {{path}}",
          "refId": "B"
        },
        {
          "expr": "signaldach_endpoint_latency_p95_ms",
          "legendFormat": "p95 {{path}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Errors by Endpoint",
      "description": "HTTP 5xx errors grouped by endpoint path",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 21,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Errors",
            "fillOpacity": 80,
            "gradientMode": "hue",
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" },
        "orientation": "horizontal",
        "xTickLabelRotation": -45,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "none",
        "showValue": "auto"
      },
      "targets": [
        {
          "expr": "signaldach_endpoint_latency_p95_ms",
          "legendFormat": "p95 {{path}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Data Pipeline",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 3,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Items Ingested",
      "description": "Total items ingested by scrapers over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 30,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Items",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "signaldach_items_total",
          "legendFormat": "Items Total",
          "refId": "A"
        },
        {
          "expr": "signaldach_scrapes_total",
          "legendFormat": "Scrapes Total",
          "refId": "B"
        },
        {
          "expr": "signaldach_scrape_errors_total",
          "legendFormat": "Scrape Errors",
          "refId": "C"
        }
      ]
    },
    {
      "type": "table",
      "title": "Collector Status (Scrape Duration)",
      "description": "Last scrape duration per source/collector",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 31,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "s",
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "color-background" },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "source_id" },
            "properties": [
              { "id": "custom.width", "value": 200 },
              { "id": "displayName", "value": "Source" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Duration (s)" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Duration (s)", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "columns", "valueLabel": "source_id" }
        }
      ],
      "targets": [
        {
          "expr": "signaldach_scrape_duration_seconds",
          "legendFormat": "{{source_id}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "row",
      "title": "Fund & Signals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 4,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "Backend uptime since last restart",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 24 },
      "id": 40,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "green", "value": 3600 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "signaldach_uptime_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Scrape Success Rate",
      "description": "Percentage of scrapes that succeeded",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 24 },
      "id": 41,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "((signaldach_scrapes_total - signaldach_scrape_errors_total) / clamp_min(signaldach_scrapes_total, 1)) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total WebSocket Connections",
      "description": "Total WS connections since startup",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 24 },
      "id": 42,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "signaldach_ws_connections_total",
          "legendFormat": "Total WS",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": []
}
